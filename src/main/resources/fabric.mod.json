{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "${description}",
    "authors": [
        "${author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/quests-teams-fixes",
        "sources": "${sources}",
        "issues": "${sources}/issues"
    },
    "license": "MIT",
    "icon": "assets/${id}/icon.png",
    "environment": "${environment}",
    "entrypoints": {
        "main": [
            "com.stalemated.qtfixes.QuestsAndTeamsFixes"
        ]
    },
    "mixins": [
        "${id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": "${minecraft}",
        "java": ">=${java_version}",
        "fabric-api": "*",
        "s_lib": ">=${slib}"
    },
    "suggests": {
        "ftbquests": ">=${ftb_quests}",
        "ftbteams": ">=${ftb_teams}",
        "ftblibrary": ">=${ftb_library}"
    }
}
